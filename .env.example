# =============================================================================
# Slicks Barber Studio — booking API configuration
# For local dev: copy this file to `.env` and fill in the values, then run
# `npm run dev`. For production: set the same keys in your hosting (e.g.
# Cloudflare Pages → Settings → Environment variables).
# =============================================================================

# --- Client (build-time, VITE_ prefix gets inlined into the bundle) ----------
# 'true' = the booking form posts to /api/bookings.
# 'false' = form confirms locally (demo mode).
VITE_BOOKINGS_API=true

# --- PostgreSQL (server-side: /api/bookings) ---------------------------------
# Single connection string. The table lives in its own dedicated database
# (slicks_booking) so no other database is affected. Create it with:
#   1) a dedicated role:      CREATE ROLE <app> WITH LOGIN PASSWORD '<pw>';
#   2) an isolated database:  CREATE DATABASE slicks_booking OWNER <app>;
#   3) run the schema in sql/schema.sql inside that database.
# Format: postgresql://user:password@host:port/database
# NOTE: if this server runs on your machine (localhost), the API can only
# reach it when the function runs locally too. For a live site, use a host
# reachable from the internet (VPS / Supabase / Neon), then set this to it.
DATABASE_URL=postgresql://slicks_app:your-app-password@your-host:5432/slicks_booking

