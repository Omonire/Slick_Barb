{
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/login", "destination": "/index.html" },
    { "source": "/admin/dashboard", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/bookings.ts": {
      "maxDuration": 10
    }
  },
  "build": {
    "env": {
      "DATABASE_URL": "@database-url"
    }
  }
}
